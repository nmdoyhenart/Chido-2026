{
  "expo": {
    "name": "Chido",
    "slug": "chido-2026",
    "scheme": "chido",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",

    "plugins": [
      "expo-font",
      "expo-image",
      "expo-router",
      "expo-web-browser",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-audio",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Chido necesita usar la cámara para tomar tu foto personal y leer el DNI.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ]
  }
}
